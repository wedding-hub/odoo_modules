<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Rebrand top-level "Invoicing" app menu to "Accounting" -->
        <record id="account.menu_finance" model="ir.ui.menu">
            <field name="name">Accounting</field>
            <field name="sequence">40</field>
            <field name="web_icon">account,static/description/icon.png</field>
        </record>

        <!-- Unlocked Accounting Journal Dashboard (Kanban) as First Menu Item -->
        <menuitem id="menu_accounting_dashboard"
                  name="Dashboard"
                  parent="account.menu_finance"
                  action="account.open_account_journal_dashboard_kanban"
                  groups="account.group_account_readonly,account.group_account_invoice"
                  sequence="1"/>

        <!-- Ensure Accounting Top Submenus -->
        <record id="account.menu_finance_receivables" model="ir.ui.menu">
            <field name="name">Customers</field>
            <field name="sequence">2</field>
        </record>

        <record id="account.menu_finance_payables" model="ir.ui.menu">
            <field name="name">Vendors</field>
            <field name="sequence">3</field>
        </record>

        <record id="account.menu_finance_entries" model="ir.ui.menu">
            <field name="name">Accounting</field>
            <field name="sequence">4</field>
            <field name="group_ids" eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]"/>
        </record>

        <record id="account.menu_finance_reports" model="ir.ui.menu">
            <field name="name">Reporting</field>
            <field name="sequence">5</field>
            <field name="group_ids" eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]"/>
        </record>

        <record id="account.menu_finance_configuration" model="ir.ui.menu">
            <field name="name">Configuration</field>
            <field name="sequence">100</field>
        </record>

        <!-- ============================================================== -->
        <!-- Accounting Menu Items (Assets)                                 -->
        <!-- ============================================================== -->
        <menuitem id="menu_action_account_asset"
                  name="Assets"
                  parent="account.menu_finance_entries"
                  action="action_account_asset"
                  groups="account.group_account_readonly,account.group_account_invoice"
                  sequence="20"/>

        <menuitem id="menu_action_asset_depreciation_wizard"
                  name="Generate Asset Depreciation"
                  parent="account.menu_finance_entries"
                  action="action_asset_depreciation_wizard"
                  groups="account.group_account_user,account.group_account_manager"
                  sequence="21"/>

        <!-- ============================================================== -->
        <!-- Reporting Menu Items (Dynamic Financial Statements)            -->
        <!-- ============================================================== -->
        <menuitem id="menu_report_financial_wizard"
                  name="Financial Reports Wizard"
                  parent="account.menu_finance_reports"
                  action="action_financial_report_wizard"
                  groups="account.group_account_readonly,account.group_account_invoice"
                  sequence="1"/>

        <menuitem id="menu_report_balance_sheet"
                  name="Balance Sheet"
                  parent="account.menu_finance_reports"
                  action="action_client_balance_sheet"
                  groups="account.group_account_readonly,account.group_account_invoice"
                  sequence="2"/>

        <menuitem id="menu_report_profit_and_loss"
                  name="Profit and Loss"
                  parent="account.menu_finance_reports"
                  action="action_client_profit_and_loss"
                  groups="account.group_account_readonly,account.group_account_invoice"
                  sequence="3"/>

        <menuitem id="menu_report_trial_balance"
                  name="Trial Balance"
                  parent="account.menu_finance_reports"
                  action="action_client_trial_balance"
                  groups="account.group_account_readonly,account.group_account_invoice"
                  sequence="4"/>

        <menuitem id="menu_report_general_ledger"
                  name="General Ledger"
                  parent="account.menu_finance_reports"
                  action="action_client_general_ledger"
                  groups="account.group_account_readonly,account.group_account_invoice"
                  sequence="5"/>

        <menuitem id="menu_report_aged_receivable"
                  name="Aged Receivable"
                  parent="account.menu_finance_reports"
                  action="action_client_aged_receivable"
                  groups="account.group_account_readonly,account.group_account_invoice"
                  sequence="6"/>

        <menuitem id="menu_report_aged_payable"
                  name="Aged Payable"
                  parent="account.menu_finance_reports"
                  action="action_client_aged_payable"
                  groups="account.group_account_readonly,account.group_account_invoice"
                  sequence="7"/>

        <!-- Inventory Valuation & FIFO GL Audit -->
        <menuitem id="menu_valuation_fifo_audit"
                  name="Inventory Valuation &amp; FIFO Audit"
                  parent="account.menu_finance_reports"
                  action="action_stock_valuation_fifo_audit"
                  groups="account.group_account_readonly,account.group_account_invoice"
                  sequence="30"/>

        <menuitem id="menu_valuation_fifo_wizard"
                  name="Run Valuation Audit"
                  parent="account.menu_finance_reports"
                  action="action_stock_valuation_fifo_wizard"
                  groups="account.group_account_readonly,account.group_account_invoice"
                  sequence="31"/>

        <!-- ============================================================== -->
        <!-- Configuration Menu Items (Asset Models)                        -->
        <!-- ============================================================== -->
        <menuitem id="menu_action_account_asset_category"
                  name="Asset Models"
                  parent="account.menu_finance_configuration"
                  action="action_account_asset_category"
                  groups="account.group_account_user,account.group_account_manager"
                  sequence="50"/>
    </data>
</odoo>
